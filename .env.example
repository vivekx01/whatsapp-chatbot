# Meta / WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-random-string-here
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# OpenRouter (LLM)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Bot behavior
SYSTEM_PROMPT=You are a helpful assistant chatting with a user over WhatsApp. Keep replies concise and conversational.
HISTORY_LIMIT=20

# Storage
DB_PATH=./data/chatbot.db

# Server
PORT=8000
